begin model
#@model_id: Rubenstein_BiophysChem2007
#@title: Nucleated polymerization of prion aggregates (Rubenstein et al., 2007)
#@description: |
#  The nucleated-polymerization model of prion replication, written as rules over
#  explicit linear aggregates rather than as moment equations. Normal prion
#  protein PrPC is produced and cleared; whole PrPSc aggregates are degraded or
#  sequestered; an aggregate elongates by converting one PrPC at its free end;
#  an inter-subunit bond cleaves to split one aggregate into two; and a chain
#  shorter than the minimum stable length reverts to PrPC. The rules are
#  unbounded, so the network is generated with a maximum stoichiometry of 120
#  PrP molecules per complex, giving 121 species and 3,843 reactions. What
#  distinguishes the problem is that the observables are aggregate-population
#  summaries -- total PrPSc protein and the number of aggregates -- whose ratio
#  is the mean chain length, so the parameters act on a size distribution rather
#  than on a handful of species counts.
#@reference: |
#  Rubenstein R, Gray PC, Cleland TJ, Piltch MS, Hlavacek WS, Roberts RM,
#  Ambrosiano J, Kim J-I (2007). Dynamics of the nucleated polymerization model
#  of prion replication. Biophysical Chemistry 125:360-367.
#  doi:10.1016/j.bpc.2006.09.011
#@source: BNGL-Models/models/prion_nucleated_polymerization_rubenstein2007, the _benchmark variant (rev f29cc7c)
#
# Benchmark adaptations (see problem.json): five rate constants are free via the
# ``name name__FREE`` alias form -- PrPC production and clearance, whole-aggregate
# clearance, elongation and cleavage. The rapid subcritical reversion rate gamma
# and the minimum stable length n stay fixed; gamma is fast enough to be at
# quasi-equilibrium and n is an integer, not a rate. Three of the five observables
# are kept; the subcritical monomer and dimer counts are dropped because they sit
# at zero or one for most of the window. The source is the folder's _benchmark
# variant, whose PrPC production rate is 12.5 times the Table 1 value so that
# aggregates take off within days rather than within a year; the window here is
# the first 5 days of its 10-day protocol, sampled every 0.05 days, which covers
# the exponential take-off. Note that x_0, the initial PrPC level, is lambda/d,
# so two of the free parameters move the initial condition as well as the rates.

begin parameters
  # Population-conversion constants; V_ref is the nominal volume of one neuronal
  # cell given in Table 1 of Rubenstein et al. (2007)
  NA     6.02214076e23  # molecules/mol
  V_ref  1e-12          # L/cell

  # PrPC production (12.5 times the Table 1 value; see the header) and the
  # Table 1 first-order clearance rate
  lambda  lambda__FREE  # molecules/day
  d       d__FREE       # /day

  # Aggregate-free steady-state PrPC level, which is therefore not independent
  # of lambda and d
  x_0  lambda/d  # molecules

  # Degradation or sequestration of a whole aggregate; Eq. 3
  a  a__FREE  # /day

  # Elongation: conversion of one PrPC at the free end of an aggregate; Eq. 4
  beta  beta__FREE  # /(molecule*day)

  # Cleavage of one inter-subunit bond; Eq. 5
  b  b__FREE  # /day

  # Rapid reversion of subcritical PrPSc chains to PrPC; Eq. 6
  gamma  100  # /day

  # Minimum stable chain length, implicit in the two reversion rules
  n  3  # dimensionless

  # Guard against division by zero when every aggregate has been cleared
  epsilon  1e-10  # aggregates
end parameters

begin molecule types
  # Prion protein in its normal cellular (C) or misfolded scrapie (Sc)
  # conformation; head and tail carry the bonds of a linear PrPSc aggregate, so
  # every chain has exactly one molecule with a free head and one with a free tail
  PrP(conf~C~Sc,head,tail)
end molecule types

begin seed species
  # PrPC starts at its aggregate-free steady state x_0 = lambda/d
  PrP(conf~C,head,tail)  x_0  # molecules

  # Three seed aggregates at the minimum stable length n = 3
  PrP(conf~Sc,head,tail!1).PrP(conf~Sc,head!1,tail!2).PrP(conf~Sc,head!2,tail)  3  # molecules
end seed species

begin observables
  # Free PrPC monomer, written x in Sec. 8 of Rubenstein et al. (2007)
  Molecules Obs_PrP_C  PrP(conf~C)
  # Total PrPSc protein held in aggregates, written z in Sec. 8
  Molecules Obs_PrP_Sc  PrP(conf~Sc)
  # Number of PrPSc aggregates, written y in Sec. 8; each chain has exactly one
  # molecule with a free head
  Molecules Obs_Agg  PrP(conf~Sc,head)
end observables

begin functions
  # Mean aggregate chain length s = z/y; epsilon keeps s finite before seeding
  # takes hold and if every aggregate is cleared
  s_mean() = Obs_PrP_Sc/(Obs_Agg+epsilon)
end functions

begin reaction rules
  # Metabolic production and first-order clearance of PrPC; Eqs. 1 and 2
  R_synthesize_PrP_C: 0 -> PrP(conf~C,head,tail) lambda
  R_degrade_PrP_C: PrP(conf~C,head,tail) -> 0 d

  # Degradation or sequestration of a whole aggregate; Eq. 3. Matching the single
  # free-head molecule of a chain makes the propensity a per aggregate and removes
  # the whole complex.
  R_clear_aggregate: PrP(conf~Sc,head) -> 0 a

  # Elongation at the free tail of an aggregate; Eq. 4
  R_elongate: PrP(conf~Sc,tail) + PrP(conf~C,head,tail) -> \
    PrP(conf~Sc,tail!1).PrP(conf~Sc,head!1,tail) beta

  # Cleavage of one inter-subunit bond; Eq. 5
  R_cleave: PrP(conf~Sc,tail!1).PrP(conf~Sc,head!1) -> \
    PrP(conf~Sc,tail) + PrP(conf~Sc,head) b

  # Rapid reversion of chains shorter than n = 3 back to PrPC; Eq. 6
  R_revert_monomer: PrP(conf~Sc,head,tail) -> PrP(conf~C,head,tail) gamma
  R_revert_dimer: PrP(conf~Sc,head,tail!1).PrP(conf~Sc,head!1,tail) -> \
    PrP(conf~C,head,tail) + PrP(conf~C,head,tail) gamma
end reaction rules
end model

begin actions
  generate_network({overwrite=>1,check_iso=>1,max_iter=>150,\
    max_stoich=>{PrP=>120}})
  simulate({method=>"ssa",suffix=>"ssa",t_start=>0,t_end=>5,n_steps=>100})
end actions
